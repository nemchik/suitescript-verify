<restlet scriptid="%%SCRIPT_ID%%">
  <description>Runs one version-controlled probe by name in a sandbox. Source: the project's verification folder, through suitescript-verify.</description>
  <isinactive>F</isinactive>
  <name>%%TITLE%%</name>
  <notifyowner>F</notifyowner>
  <scriptfile>[/SuiteScripts/%%FOLDER%%/runner.js]</scriptfile>
  <scriptdeployments>
    <scriptdeployment scriptid="%%DEPLOY_ID%%">
      <allroles>F</allroles>
      <audslctrole>[%%ROLE_ID%%]</audslctrole>
      <isdeployed>%%DEPLOYED%%</isdeployed>
      <loglevel>DEBUG</loglevel>
      <status>RELEASED</status>
      <title>%%TITLE%%</title>
    </scriptdeployment>
  </scriptdeployments>
</restlet>
